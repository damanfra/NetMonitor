<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NetMonitor</AssemblyName>
    <RootNamespace>NetMonitor</RootNamespace>
    <Version>1.0.0</Version>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <!-- Gera só os idiomas que temos (evita pastas de satélite de pacotes NuGet). Ao adicionar inglês: pt-BR;en -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <Product>NetMonitor</Product>
    <Description>Monitor de tráfego de rede por aplicativo com bloqueio via Firewall do Windows</Description>
    <!-- Permite compilar a partir de Linux/macOS (CI); o executável só roda no Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
