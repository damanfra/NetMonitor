<Window x:Class="NetMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NetMonitor.Localization"
        Title="{l:T Window_Title}"
        Width="1180" Height="760" MinWidth="820" MinHeight="480"
        Background="#F7F8FA" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Célula "aplicativo": ícone + nome + subtítulo -->
        <DataTemplate x:Key="AppCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ExePath}">
                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="4,0,8,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Background="#FEE2E2" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{l:T Badge_Blocked}" FontSize="10" FontWeight="Bold" Foreground="#B91C1C" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TotalCell">
            <StackPanel VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" />
                <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="3" BorderThickness="0"
                             Background="#E5E7EB" Foreground="{StaticResource Accent}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:T Toolbar_ShowActivity}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}"
                              DisplayMemberPath="Label" Width="160" />
                    <TextBlock Text="{l:T Toolbar_Search}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" VerticalContentAlignment="Center" />
                    <CheckBox Content="{l:T Filter_HideWindows}" IsChecked="{Binding HideWindowsComponents}"
                              VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="{l:T Filter_HideWindows_Tooltip}" />
                    <CheckBox Content="{l:T Filter_HideMicrosoft}" IsChecked="{Binding HideMicrosoftApps}"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="{l:T Filter_HideMicrosoft_Tooltip}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↓ " Foreground="{StaticResource Down}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalDownText}" FontWeight="SemiBold" />
                    <TextBlock Text="   ↑ " Foreground="{StaticResource Up}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalUpText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RateText}" Foreground="{StaticResource Muted}" Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Avisos -->
        <Border DockPanel.Dock="Top" Background="#FEE2E2" Padding="14,6" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorBanner}" Foreground="#991B1B" TextWrapping="Wrap" />
        </Border>
        <Border DockPanel.Dock="Top" Background="#FEF3C7" Padding="14,6" Visibility="{Binding FirewallDisabled, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="#92400E" TextWrapping="Wrap"
                       Text="{l:T Banner_FirewallDisabled}" />
        </Border>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,4">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" />
        </Border>

        <TabControl Margin="10" Padding="0">
            <!-- ================= ATIVIDADE ================= -->
            <TabItem Header="{Binding ActivityTabHeader}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="200" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ActivityGrid" ItemsSource="{Binding ActivityRows}"
                              SelectedItem="{Binding SelectedRow}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T Menu_ToggleBlock}" Command="{Binding ToggleBlockCommand}" CommandParameter="{Binding SelectedRow}" />
                                <MenuItem Header="{l:T Menu_Hide}" Command="{Binding HideCommand}" CommandParameter="{Binding SelectedRow}" />
                                <Separator />
                                <MenuItem Header="{l:T Menu_OpenLocation}" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding SelectedRow}" />
                                <MenuItem Header="{l:T Menu_CopyPath}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedRow}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T Column_App}" Width="*" SortMemberPath="DisplayName" CellTemplate="{StaticResource AppCell}" />
                            <DataGridTextColumn Header="{l:T Column_Download}" Binding="{Binding DownloadText}" SortMemberPath="Download" Width="95" />
                            <DataGridTextColumn Header="{l:T Column_Upload}" Binding="{Binding UploadText}" SortMemberPath="Upload" Width="95" />
                            <DataGridTemplateColumn Header="{l:T Column_Total}" SortMemberPath="Total" Width="110" CellTemplate="{StaticResource TotalCell}" />
                            <DataGridTextColumn Header="{l:T Column_Now}" Binding="{Binding RateText}" SortMemberPath="CurrentRate" Width="170" />
                            <DataGridTextColumn Header="{l:T Column_LastActivity}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenUtc" Width="95" />
                            <DataGridTextColumn Header="{l:T Column_Hosts}" Binding="{Binding HostCount}" SortMemberPath="HostCount" Width="55" />
                            <DataGridTemplateColumn Header="{l:T Column_Actions}" Width="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding BlockButtonText}" Width="85"
                                                    Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{l:T Button_Hide}" Width="75"
                                                    Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#E5E7EB" />

                    <!-- Detalhes do app selecionado -->
                    <DockPanel Grid.Row="2" Background="White">
                        <StackPanel DockPanel.Dock="Top" Margin="10,6">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{l:T Details_ConnectionsOf}" /><Run Text="{Binding SelectedRow.DisplayName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SelectedRow.ExePath, Mode=OneWay}" /><Run Text="{l:T Details_Pids}" /><Run Text="{Binding SelectedRow.PidsText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding SelectedRow.Hosts}" RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Column_Host}" Binding="{Binding HostName}" Width="*" />
                                <DataGridTextColumn Header="{l:T Column_Ip}" Binding="{Binding Address}" Width="220" />
                                <DataGridTextColumn Header="{l:T Column_Port}" Binding="{Binding Port}" Width="60" />
                                <DataGridTextColumn Header="{l:T Column_Received}" Binding="{Binding DownloadText}" Width="95" />
                                <DataGridTextColumn Header="{l:T Column_Sent}" Binding="{Binding UploadText}" Width="95" />
                                <DataGridTextColumn Header="{l:T Column_LastActivity}" Binding="{Binding LastSeenText}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= BLOQUEADOS ================= -->
            <TabItem Header="{Binding BlockedTabHeader}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" Background="White">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{l:T Blocked_OpenFirewall}" Command="{Binding OpenFirewallCommand}" />
                                <Button Content="{l:T Blocked_UnblockAll}" Command="{Binding UnblockAllCommand}" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       Text="{l:T Blocked_Hint}" />
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding BlockedRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T Column_App}" Width="*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="4,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{StaticResource Muted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Column_Service}" Binding="{Binding Service}" Width="160" />
                            <DataGridTextColumn Header="{l:T Column_BlockedAt}" Binding="{Binding BlockedAtText}" Width="130" />
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{l:T Button_Unblock}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= OCULTOS ================= -->
            <TabItem Header="{Binding HiddenTabHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="10,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{l:T Hidden_Hint}" />
                    <DataGrid ItemsSource="{Binding HiddenRows}" SelectedItem="{Binding SelectedRow}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:T Column_App}" Width="*" SortMemberPath="DisplayName" CellTemplate="{StaticResource AppCell}" />
                            <DataGridTextColumn Header="{l:T Column_Download}" Binding="{Binding DownloadText}" SortMemberPath="Download" Width="95" />
                            <DataGridTextColumn Header="{l:T Column_Upload}" Binding="{Binding UploadText}" SortMemberPath="Upload" Width="95" />
                            <DataGridTemplateColumn Header="{l:T Column_Total}" SortMemberPath="Total" Width="110" CellTemplate="{StaticResource TotalCell}" />
                            <DataGridTextColumn Header="{l:T Column_LastActivity}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenUtc" Width="95" />
                            <DataGridTemplateColumn Header="{l:T Column_Actions}" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:T Button_Unhide}" Width="130"
                                                    Command="{Binding DataContext.UnhideCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{Binding BlockButtonText}" Width="95"
                                                    Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= CONFIGURAÇÕES ================= -->
            <TabItem Header="{l:T Tab_Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                    <StackPanel Margin="20,14" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style x:Key="Section" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Margin" Value="0,14,0,6" />
                            </Style>
                            <Style x:Key="Hint" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="22,2,0,6" />
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="{l:T Settings_Startup}" Style="{StaticResource Section}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T Settings_StartWithWindows}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton Content="{l:T Common_Yes}" GroupName="Startup" IsChecked="{Binding StartWithWindows}" Margin="0,0,16,0" />
                            <RadioButton Content="{l:T Common_No}" GroupName="Startup" IsChecked="{Binding NotStartWithWindows}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                   Text="{l:T Settings_StartWithWindows_Hint}" />
                        <CheckBox Content="{l:T Settings_MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />

                        <TextBlock Text="{l:T Settings_Alerts}" Style="{StaticResource Section}" />
                        <CheckBox Content="{l:T Settings_AlertsEnabled}" IsChecked="{Binding AlertsEnabled}" />
                        <StackPanel Orientation="Horizontal" Margin="22,4,0,0" IsEnabled="{Binding AlertsEnabled}">
                            <TextBlock Text="{l:T Settings_AlertWhenOver}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding AlertThresholdMb, UpdateSourceTrigger=LostFocus}" Width="70" Margin="6,0"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                            <TextBlock Text="{l:T Settings_AlertMbIn}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedAlertWindow}"
                                      DisplayMemberPath="Label" Width="160" Margin="6,0" />
                        </StackPanel>
                        <CheckBox Content="{l:T Settings_AlertIncludeHidden}" IsChecked="{Binding AlertIncludeHidden}"
                                  Margin="22,8,0,0" IsEnabled="{Binding AlertsEnabled}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T Settings_Alerts_Hint}" />
                        <Button Content="{l:T Settings_TestNotification}" HorizontalAlignment="Left" Margin="22,0,0,0" Command="{Binding TestNotificationCommand}" />

                        <TextBlock Text="{l:T Settings_Blocking}" Style="{StaticResource Section}" />
                        <CheckBox Content="{l:T Settings_CloseConnections}" IsChecked="{Binding CloseConnectionsOnBlock}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:T Settings_CloseConnections_Hint}" />

                        <TextBlock Text="{l:T Settings_Display}" Style="{StaticResource Section}" />
                        <CheckBox Content="{l:T Filter_HideWindows}" IsChecked="{Binding HideWindowsComponents}" />
                        <CheckBox Content="{l:T Filter_HideMicrosoft}" IsChecked="{Binding HideMicrosoftApps}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{l:T Settings_Language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding LanguageCode}"
                                      SelectedValuePath="Code" DisplayMemberPath="Name" Width="200" />
                        </StackPanel>

                        <TextBlock Text="{l:T Settings_About}" Style="{StaticResource Section}" />
                        <TextBlock Text="{Binding VersionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{l:T Settings_FileLocation}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SettingsFilePath}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <Button Content="{l:T Settings_OpenFolder}" Margin="8,0,0,0" Command="{Binding OpenSettingsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
